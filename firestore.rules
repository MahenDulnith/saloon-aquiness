rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Jobs / bookings: can be created and updated, but NEVER erased and the
    // money fields (price, date, customer) can never be edited afterwards.
    match /appointments/{id} {
      allow read: if true;
      allow create: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status', 'staffId', 'staffName', 'completedAt', 'completedBy',
        'deleted', 'deletedAt', 'deletedBy', 'paymentMethod', 'notes', 'firestoreTimestamp'
      ]);
      allow delete: if false;
    }

    // Permanent history of every change - append only.
    match /auditLog/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Services and staff stay editable by the app (as before).
    match /services/{id} {
      allow read, write: if true;
    }
    match /staff/{id} {
      allow read, write: if true;
    }

    // Security alert logs and trigger email queue (append-only).
    match /security_alerts/{id} {
      allow read, create: if true;
      allow update, delete: if false;
    }
    match /mail/{id} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // Anything else is closed.
  }
}
